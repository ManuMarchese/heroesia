# Copiá este archivo a .env.local y completá los valores. Nunca subas .env.local al repo.

# Supabase: URL del proyecto y clave publicable (sb_publishable_...). La app no usa la clave secreta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: token de GitHub para leer datos de repos sin agotar el límite público.
GITHUB_TOKEN=

# Solo para probar en tu compu sin Supabase: poné 1 para usar datos de ejemplo. Nunca en producción.
HEROES_DEMO=
